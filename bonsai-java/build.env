# Grammar pins for bonsai-java, consumed verbatim as `docker build`
# --build-arg values by build/regen.sh (and by CI's regen workflow).
# Keys must match the ARGs declared in Dockerfile.builder.
GRAMMAR_NAME=java
GRAMMAR_REPO=https://github.com/tree-sitter/tree-sitter-java.git
GRAMMAR_TAG=v0.23.5
GRAMMAR_DIR=tree-sitter-java
LANGUAGE_SYMBOL=tree_sitter_java
GRAMMAR_HAS_SCANNER=0
