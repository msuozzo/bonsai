# Grammar pins for bonsai-rust, consumed verbatim as `docker build`
# --build-arg values by build/regen.sh (and by CI's regen workflow).
# Keys must match the ARGs declared in Dockerfile.builder.
GRAMMAR_NAME=rust
GRAMMAR_REPO=https://github.com/tree-sitter/tree-sitter-rust.git
GRAMMAR_TAG=v0.24.2
GRAMMAR_DIR=tree-sitter-rust
LANGUAGE_SYMBOL=tree_sitter_rust
GRAMMAR_HAS_SCANNER=1
