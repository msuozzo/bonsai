# Grammar pins for bonsai-ruby, consumed verbatim as `docker build`
# --build-arg values by build/regen.sh (and by CI's regen workflow).
# Keys must match the ARGs declared in Dockerfile.builder.
GRAMMAR_NAME=ruby
GRAMMAR_REPO=https://github.com/tree-sitter/tree-sitter-ruby.git
GRAMMAR_TAG=v0.23.1
GRAMMAR_DIR=tree-sitter-ruby
LANGUAGE_SYMBOL=tree_sitter_ruby
GRAMMAR_HAS_SCANNER=1
