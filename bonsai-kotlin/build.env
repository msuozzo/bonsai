# Grammar pins for bonsai-kotlin, consumed verbatim as `docker build`
# --build-arg values by build/regen.sh (and by CI's regen workflow).
# Keys must match the ARGs declared in Dockerfile.builder.
GRAMMAR_NAME=kotlin
GRAMMAR_REPO=https://github.com/tree-sitter-grammars/tree-sitter-kotlin.git
GRAMMAR_TAG=v1.1.0
GRAMMAR_DIR=tree-sitter-kotlin
LANGUAGE_SYMBOL=tree_sitter_kotlin
GRAMMAR_HAS_SCANNER=1
