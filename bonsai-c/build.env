# Grammar pins for bonsai-c, consumed verbatim as `docker build`
# --build-arg values by build/regen.sh (and by CI's regen workflow).
# Keys must match the ARGs declared in Dockerfile.builder.
GRAMMAR_NAME=c
GRAMMAR_REPO=https://github.com/tree-sitter/tree-sitter-c.git
GRAMMAR_TAG=v0.24.2
GRAMMAR_DIR=tree-sitter-c
LANGUAGE_SYMBOL=tree_sitter_c
GRAMMAR_HAS_SCANNER=0
