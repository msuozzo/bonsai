# Grammar pins for bonsai-typescript, consumed verbatim as `docker build`
# --build-arg values by build/regen.sh (and by CI's regen workflow).
# Keys must match the ARGs declared in Dockerfile.builder.
# The typescript grammar lives in the typescript/ subdir of the repo,
# beside its tsx/ sibling (see bonsai-tsx).
GRAMMAR_NAME=typescript
GRAMMAR_REPO=https://github.com/tree-sitter/tree-sitter-typescript.git
GRAMMAR_TAG=v0.23.2
GRAMMAR_DIR=tree-sitter-typescript
GRAMMAR_SRC_SUBDIR=typescript
LANGUAGE_SYMBOL=tree_sitter_typescript
GRAMMAR_HAS_SCANNER=1
