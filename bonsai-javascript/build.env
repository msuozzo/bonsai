# Grammar pins for bonsai-javascript, consumed verbatim as `docker build`
# --build-arg values by build/regen.sh (and by CI's regen workflow).
# Keys must match the ARGs declared in Dockerfile.builder.
GRAMMAR_NAME=javascript
GRAMMAR_REPO=https://github.com/tree-sitter/tree-sitter-javascript.git
GRAMMAR_TAG=v0.25.0
GRAMMAR_DIR=tree-sitter-javascript
LANGUAGE_SYMBOL=tree_sitter_javascript
GRAMMAR_HAS_SCANNER=1
