# Grammar pins for bonsai-tsx, consumed verbatim as `docker build`
# --build-arg values by build/regen.sh (and by CI's regen workflow).
# Keys must match the ARGs declared in Dockerfile.builder.
# The tsx grammar lives in the tsx/ subdir of the repo, beside its
# typescript/ sibling (see bonsai-typescript).
GRAMMAR_NAME=tsx
GRAMMAR_REPO=https://github.com/tree-sitter/tree-sitter-typescript.git
GRAMMAR_TAG=v0.23.2
GRAMMAR_DIR=tree-sitter-typescript
GRAMMAR_SRC_SUBDIR=tsx
LANGUAGE_SYMBOL=tree_sitter_tsx
GRAMMAR_HAS_SCANNER=1
